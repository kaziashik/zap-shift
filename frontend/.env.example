# ZapShift Frontend — copy to .env and fill in your values
# cp .env.example .env

# Firebase Web App config
VITE_apiKey=
VITE_authDomain=
VITE_projectId=
VITE_storageBucket=
VITE_messagingSenderId=
VITE_appId=

# Backend API base URL (local or deployed)
VITE_API_URL=

# Optional: ImgBB key for profile image upload
VITE_image_host_key=
