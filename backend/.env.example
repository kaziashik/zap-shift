# ZapShift Backend — copy to .env and fill in your values
# cp .env.example .env

PORT=
NODE_ENV=

# MongoDB Atlas
DB_USER=
DB_PASS=

# Firebase Admin SDK service account JSON (base64-encoded)
FB_SERVICE_KEY=

# Stripe
STRIPE_SECRET_KEY=

# Frontend URLs (CORS + Stripe redirects)
SITE_DOMAIN=
CLIENT_URL=
